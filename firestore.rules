rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(tripId) {
      return signedIn() && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /trips/{tripId} {
      // Anyone holding the (unguessable) link can see the trip name to join it.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember(tripId);

      match /members/{uid} {
        allow read: if signedIn();
        // You can only create/edit your own membership.
        allow create, update: if signedIn() && request.auth.uid == uid;
      }

      match /locations/{uid} {
        allow read: if isMember(tripId);
        // Only you can move your own pin.
        allow write: if isMember(tripId) && request.auth.uid == uid;
      }

      match /documents/{docId} {
        allow read, create: if isMember(tripId);
        // Only whoever uploaded a document can change or delete it.
        allow update, delete: if isMember(tripId) && resource.data.by == request.auth.uid;
      }

      match /{sub}/{docId} {
        allow read, write: if !(sub in ['members', 'locations', 'documents']) && isMember(tripId);
      }
    }
  }
}
